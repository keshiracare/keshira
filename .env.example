# -----------------------------------------------------------------------------
# KESHIRA WEBSITE ENVIRONMENT VARIABLES EXAMPLE
# Rename this file to '.env' and fill in your actual credentials.
# -----------------------------------------------------------------------------

# --- Admin Authentication ---
# The password used to access the Apothecary Control Center (/admin).
# Fallback is 'admin123' if not specified.
VITE_ADMIN_PASSCODE=your_secret_admin_passcode

# --- EmailJS Configuration ---
# Optional: Override default keys for email confirmation receipts.
VITE_EMAILJS_SERVICE_ID=service_ez47q6c
VITE_EMAILJS_TEMPLATE_ID=template_felpos2
VITE_EMAILJS_ADMIN_TEMPLATE_ID=your_emailjs_admin_template_id
VITE_EMAILJS_PUBLIC_KEY=dUvyAAVmDEHvYT4Nb

# --- Push Notifications (Admin Alerts) ---
# Optional: Get instant notifications on your phone when someone orders.
# Discord Webhook URL:
VITE_DISCORD_WEBHOOK_URL=your_discord_webhook_url
# Telegram Bot Token & Chat ID:
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Supabase Configuration ---
# Required: Credentials for Supabase PostgreSQL database integration.
# Obtain these from your Supabase Dashboard (Project Settings > API).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
